# ============================================
# Database & Redis
# docker-compose.yml overrides these to use
# Docker service names (db, redis, minio).
# ============================================
DATABASE_URL=postgresql+asyncpg://dating_user:dating_pass@localhost:5432/dating_db
# When running via docker compose, DATABASE_URL is overridden to go through
# pgbouncer (@pgbouncer:5432). REDIS_PASSWORD must match what the redis
# container uses (--requirepass). Empty = no auth.
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ============================================
# Security — CHANGE THIS in production
# ============================================
SECRET_KEY=change-this-to-64-random-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============================================
# Google OAuth (optional)
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# Admin — CHANGE THIS in production
# ============================================
# Admin panel / operator login (POST /api/v1/admin/login -> 60-min admin JWT).
# ADMIN_PASSWORD_HASH is a bcrypt hash. Generate one with:
#   docker compose run --rm app python -c "from app.core.security import hash_password; print(hash_password('<password>'))"
# Admin endpoints accept the JWT (Authorization: Bearer) or the legacy
# X-Admin-Key header (ADMIN_SECRET_KEY). No app user account is required.
ADMIN_SECRET_KEY=change-this-to-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ============================================
# App Settings
# ============================================
APP_NAME=DatingApp
DEBUG=True
ENVIRONMENT=development

# Number of uvicorn (FastAPI) workers. Leave empty for auto-tuning by CPU + RAM
# (the box's cores/RAM are read at container start). Pin an exact number here
# if you want a fixed count, e.g. WEB_WORKERS=5.
WEB_WORKERS=

# ============================================
# Daily Limits
# ============================================
FREE_USER_DAILY_LIKES=20
FREE_USER_DAILY_CHATS=10
AD_REWARD_LIKES_BONUS=5
AD_REWARD_CHATS_BONUS=3
MAX_AD_REWARDS_PER_DAY=2
WELCOME_BONUS_DAYS=7
REFERRAL_INVITER_DAYS=3
REFERRAL_INVITED_DAYS=3

# ============================================
# Subscription Plans
# ============================================
SUBSCRIPTION_MONTHLY_DAYS=30
SUBSCRIPTION_QUARTERLY_DAYS=90
SUBSCRIPTION_YEARLY_DAYS=365
SUBSCRIPTION_QUARTERLY_DISCOUNT=15
SUBSCRIPTION_YEARLY_DISCOUNT=30

# ============================================
# Payment (ZarinPal)
# ============================================
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=

# ============================================
# MinIO / S3 — CHANGE THE DEFAULT CREDS in production
# ============================================
# Credentials used by the minio container itself:
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=${MINIO_ROOT_USER:-minioadmin}
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD:-minioadmin}
S3_REGION=us-east-1
S3_PUBLIC_BUCKET=photos-public
S3_PRIVATE_BUCKET=photos-private
# When MinIO is served through nginx (Option B — no public :9000), point BOTH
# of these at the public host (port 80/443). S3_ENDPOINT_URL determines the host
# embedded in presigned URLs, so it must be reachable from the client:
#   S3_ENDPOINT_URL=http(s)://<domain-or-ip>
#   S3_PUBLIC_BASE_URL=http(s)://<domain-or-ip>/photos-public
# Must be reachable from the CLIENT (phone/browser), NOT the container network.
# Docker compose overrides this to the internal host unless set here, so set it
# to a value devices can load, otherwise photos 404 with a "minio" DNS error:
#   http://<server-ip>:9000/photos-public   # real device / deployed server
#   http://10.0.2.2:9000/photos-public      # Android emulator (host machine)
#   http://localhost:9000/photos-public     # web preview on same machine
S3_PUBLIC_BASE_URL=http://localhost:9000/photos-public
S3_SIGNED_URL_EXPIRE_SECONDS=900

# ============================================
# Upload Limits
# ============================================
MAX_PHOTO_SIZE_MB=10
MAX_PHOTOS_PER_USER=9

# ============================================
# Encryption — CHANGE THIS in production
# ============================================
ENCRYPTION_SECRET=change-this-to-32-byte-key

# ============================================
# Error Tracking (GlitchTip)
# ============================================
GLITCHTIP_DSN=
GLITCHTIP_SECRET_KEY=

# ============================================
# FCM Push Notifications
# ============================================
# Path to the Firebase service account JSON file.
# The file must exist on the host at this path (gitignored).
# For production, upload the JSON to the VPS and set the path accordingly.
FCM_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# ============================================
# Celery (durable task queue)
# ============================================
# When enabled, push notifications are enqueued to Redis and sent by the
# celery-worker service (retryable, survives restarts). In production set to
# true; leave false for tests/lite dev (work runs inline instead).
CELERY_ENABLED=false

# Celery worker concurrency. "auto" (default) = number of server CPUs, read at
# container start. Pin an exact number here to override, e.g. CELERY_CONCURRENCY=2.
# Bound this to keep app+worker DB connections comfortably inside the pgbouncer
# DEFAULT_POOL_SIZE (docker-compose.yml): worker holds up to CONCURRENCY x 5.
CELERY_CONCURRENCY=auto

# ============================================
# NSFW Detection
# ============================================
NSFW_ENABLED=true
NSFW_THRESHOLD=0.8

# ============================================
# CORS — set your domain in production
# ============================================
CORS_ORIGINS=

# ============================================
# Redis Settings
# ============================================
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=True
REDIS_MAX_RETRIES=3
